#!/bin/sh
set -eu

options_file=/data/options.json

option() {
    key="$1"
    default="$2"
    value=""

    if [ -r "$options_file" ]; then
        value="$(python - "$options_file" "$key" 2>/dev/null <<'PY' || true
import json
import sys

with open(sys.argv[1], encoding="utf-8") as options_file:
    value = json.load(options_file).get(sys.argv[2])

if value is not None:
    print(value, end="")
PY
        )"
    fi

    if [ -n "$value" ]; then
        printf '%s' "$value"
    else
        printf '%s' "$default"
    fi
}

export PUID="$(option PUID 0)"
export PGID="$(option PGID 0)"
export TZ="$(option TZ UTC)"
umask "$(option UMASK 002)"

exec /entrypoint.sh "$@"
