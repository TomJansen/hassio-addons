#!/bin/sh
set -eu

options_file=/data/options.json

option() {
    key="$1"
    default="$2"

    if [ -r "$options_file" ]; then
        value="$(jq -er --arg key "$key" '.[$key] // empty' "$options_file" 2>/dev/null || true)"
        if [ -n "$value" ]; then
            printf '%s' "$value"
            return
        fi
    fi

    printf '%s' "$default"
}

export PUID="$(option PUID 1000)"
export PGID="$(option PGID 1000)"
export TZ="$(option TZ UTC)"
export INGEST_DIR="$(option INGEST_DIR /share/cwa-book-ingest)"
export HARDCOVER_TOKEN="$(option HARDCOVER_TOKEN '')"
export NETWORK_SHARE_MODE="$(option NETWORK_SHARE_MODE false)"

INGEST_DIR="$(realpath -m -- "$INGEST_DIR")"
case "$INGEST_DIR" in
    /share/* | /media/*) ;;
    *)
        echo "INGEST_DIR must be a subdirectory of /share or /media" >&2
        exit 1
        ;;
esac
export INGEST_DIR

# The upstream auto-library service only manages /calibre-library, which is an
# image volume and is not retained when Supervisor recreates the container.
# Seed and select the add-on's persistent library instead.
persistent_library_dir=/share/calibre-web-automated/library
mkdir -p \
    "$INGEST_DIR" \
    "$persistent_library_dir" \
    /share/calibre-web-automated/plugins

if [ ! -f "$persistent_library_dir/metadata.db" ]; then
    cp /app/calibre-web-automated/empty_library/metadata.db \
        "$persistent_library_dir/metadata.db"
fi

if [ ! -f /config/app.db ]; then
    cp /app/calibre-web-automated/empty_library/app.db /config/app.db
fi

library_dir="$(sqlite3 /config/app.db \
    'SELECT config_calibre_dir FROM settings LIMIT 1;' 2>/dev/null || true)"
case "$library_dir" in
    '' | /calibre-library | /calibre-library/)
        library_dir="$persistent_library_dir"
        sqlite3 /config/app.db \
            "UPDATE settings SET config_calibre_dir='$persistent_library_dir';"
        ;;
esac
chown "$PUID:$PGID" /config/app.db
export DISABLE_LIBRARY_AUTOMOUNT=true

# CWA v4 keeps active storage paths in dirs.json. The bundled file lives in
# /app and is lost whenever Supervisor recreates the container, so keep the
# active copy in the add-on's persistent configuration volume instead.
bundled_dirs_file=/app/calibre-web-automated/dirs.json
dirs_file=/config/dirs.json
dirs_tmp="${dirs_file}.addon-init"

if [ ! -f "$dirs_file" ]; then
    cp "$bundled_dirs_file" "$dirs_file"

    # Existing installs already have the selected library in app.db. Preserve
    # it when migrating dirs.json into persistent storage for the first time.
    if [ -n "$library_dir" ]; then
        jq --arg path "$library_dir" \
            '.calibre_library_dir = $path' "$dirs_file" > "$dirs_tmp"
        mv "$dirs_tmp" "$dirs_file"
    fi
fi

jq --arg path "$INGEST_DIR" '.ingest_folder = $path' "$dirs_file" > "$dirs_tmp"
mv "$dirs_tmp" "$dirs_file"
chown "$PUID:$PGID" "$dirs_file"
chmod 0644 "$dirs_file"
ln -sfn "$dirs_file" "$bundled_dirs_file"

exec /init
